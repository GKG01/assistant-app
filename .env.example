NOVA_ENV=development
NOVA_DATABASE_PATH=data/nova.db
OPENAI_API_KEY=
# JSON array of absolute native-platform directories; empty denies access.
# Windows example (replace with your own paths; forward slashes avoid JSON escaping):
# NOVA_ALLOWED_DIRECTORIES=["C:/Users/your-account/Documents","C:/Users/your-account/Downloads"]
# WSL example: NOVA_ALLOWED_DIRECTORIES=["/home/your-account/Documents"]
# Restart the backend after editing. No links, network paths, or system roots.
NOVA_ALLOWED_DIRECTORIES=[]
